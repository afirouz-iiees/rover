# the data directory - data, timeseries.sqlite
data-dir=/home/raise/Projects/Clusty-Main/data/Waveform/data
# maximum number of attempts to download data
download-retries=3
# number of download instances to run
download-workers=5
# output data format. Choose from "mseed" (miniSEED) or "asdf" (ASDF)
output-format=mseed
# name of ASDF file when ASDF output is specified
asdf-filename=asdf.h5
# station service url
station-url=https://eida.gein.noa.gr/fdsnws/station/1/query
# availability service url
availability-url=https://eida.gein.noa.gr/fdsnws/availability/1/query
# dataselect service url
dataselect-url=https://eida.gein.noa.gr/fdsnws/dataselect/1/query
# temporary storage for downloads
temp-dir=/home/raise/Projects/Clusty-Main/data/Waveform/tmp
# directory for logs
log-dir=/home/raise/Projects/Clusty-Main/data/Waveform/logs
# log verbosity (0-6)
log-verbosity=4
# console verbosity (0-6)
verbosity=4
# auto-start the download progress web server?
web=True
# port for HTTP server
http-port=8000
